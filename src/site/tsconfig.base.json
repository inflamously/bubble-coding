{
  // Shared by src/site/bubble-web, src/site/terminal and src/site/build. Each folder has its own tsconfig with
  // the libs it may use. tsc only type-checks them (npm run check); build.mjs bundles them with esbuild.
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmit": true,
    "strict": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true
  }
}
