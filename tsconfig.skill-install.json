{
  // src/skill-install/*.ts compiles into skill-install/, the committed JS that `node install.js` runs.
  // It is kept out of skills/bubble/scripts because that folder is copied into every installed repo.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src/skill-install",
    "outDir": "skill-install"
  },
  "include": ["src/skill-install"],
  "exclude": []
}
